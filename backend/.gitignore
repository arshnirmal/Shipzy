# ============================================================================
# Shipzy Backend Service - Node.js .gitignore
# ============================================================================
# Node.js/Fastify backend service .gitignore for the Shipzy API
# Includes comprehensive patterns for Node.js, Docker, and backend development
# ============================================================================

# ============================================================================
# Dependencies & Package Managers
# ============================================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnpm-debug.log*

# Package manager lock files (keep one, comment out others)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================================================
# Build Artifacts & Outputs
# ============================================================================

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Coverage reports
coverage/
*.lcov
.nyc_output/
coverage.lcov

# TypeScript
*.tsbuildinfo

# ============================================================================
# Environment & Secrets
# ============================================================================

# Environment files
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# Firebase service accounts
*firebase*adminsdk*.json
*service-account*.json
firebase-debug.log
firestore-debug.log

# SSL/TLS certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# API keys and secrets
secrets/
credentials/
keys/
*.key
*.pem
*.crt

# ============================================================================
