{
  "name": "shipzy-backend",
  "version": "1.0.0",
  "description": "Shipzy hyperlocal delivery platform backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "NODE_ENV=development nodemon src/server.js",
    "dev:debug": "NODE_ENV=development nodemon --inspect=0.0.0.0:9229 src/server.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --coverage --verbose",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --watch --verbose",
    "test:all": "NODE_ENV=test node tests/test-runner.js",
    "test:addresses": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/addresses.test.js --verbose",
    "test:auth": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/auth.test.js --verbose",
    "test:users": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/users.test.js --verbose",
    "test:drivers": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/drivers.test.js --verbose",
    "test:orders": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/orders.test.js --verbose",
    "test:static": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/static.test.js --verbose",
    "test:system": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/system.test.js --verbose",
    "test:coverage": "NODE_ENV=test jest --coverage --coverageDirectory=coverage --coverageReporters=html,text,lcov,json-summary",
    "test:db:setup": "NODE_ENV=test node tests/database.js setup",
    "test:db:cleanup": "NODE_ENV=test node tests/database.js cleanup",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:test": "eslint tests/",
    "lint:test:fix": "eslint tests/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:test": "prettier --write \"tests/**/*.js\"",
    "db:init": "psql -U shipzy_user -d shipzy_dev -f src/database/init/schema.sql",
    "db:functions": "psql -U shipzy_user -d shipzy_dev -f src/database/functions/*.sql",
    "db:seed": "psql -U shipzy_user -d shipzy_dev -f src/database/seeds/dev-data.sql"
  },
  "keywords": [
    "delivery",
    "logistics",
    "fastify",
    "postgres"
  ],
  "author": "Shipzy Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.3.1",
    "node-cache": "^5.1.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
