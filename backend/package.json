{
  "name": "shipzy-backend",
  "version": "1.0.0",
  "description": "Shipzy hyperlocal delivery platform backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "NODE_ENV=production node dist/server.js",
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "dev:debug": "NODE_ENV=development tsx --inspect=0.0.0.0:9229 src/server.ts",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --coverage --verbose",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --watch --verbose",
    "test:all": "NODE_ENV=test node tests/test-runner.js",
    "test:addresses": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/addresses.test.js --verbose",
    "test:auth": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/auth.test.js --verbose",
    "test:users": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/users.test.js --verbose",
    "test:drivers": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/drivers.test.js --verbose",
    "test:orders": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/orders.test.js --verbose",
    "test:static": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/static.test.js --verbose",
    "test:system": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/system.test.js --verbose",
    "test:coverage": "NODE_ENV=test jest --coverage --coverageDirectory=coverage --coverageReporters=html,text,lcov,json-summary",
    "test:db:setup": "NODE_ENV=test node tests/database.js setup",
    "test:db:cleanup": "NODE_ENV=test node tests/database.js cleanup",
    "lint": "eslint src/ --ext .ts,.js",
    "lint:fix": "eslint src/ --ext .ts,.js --fix",
    "lint:test": "eslint tests/ --ext .ts,.js",
    "lint:test:fix": "eslint tests/ --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "format:test": "prettier --write \"tests/**/*.{ts,js}\"",
    "db:generate": "tsx scripts/db-generate-migration.ts",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:reset": "./scripts/db-reset.sh",
    "db:backup": "./scripts/db-backup.sh",
    "db:restore": "./scripts/db-restore.sh",
    "db:seed": "tsx scripts/seed-api.ts",
    "db:seed:dev": "psql -U shipzy_user -d shipzy_dev -f src/database/seeds/dev-data.sql",
    "dev:setup": "./scripts/startup.sh",
    "dev:reset": "FORCE_RESET=true ./scripts/db-reset.sh && pnpm run dev",
    "dev:start": "docker compose -f docker-compose.dev.yml up -d --build",
    "dev:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:clean": "docker compose -f docker-compose.dev.yml down -v"
  },
  "keywords": [
    "delivery",
    "logistics",
    "fastify",
    "postgres"
  ],
  "author": "Shipzy Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "0.45.1",
    "fastify": "^5.8.2",
    "firebase-admin": "^13.7.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "bcrypt",
      "esbuild",
      "protobufjs"
    ],
    "overrides": {
      "fast-xml-parser": "^5.3.5",
      "node-forge": "^1.3.2",
      "jws": "4.0.1",
      "@tootallnate/once": "^3.0.1",
      "tar": "^7.5.4",
      "bn.js": "^4.12.3",
      "minimatch@^3.0.0": "3.1.5",
      "minimatch@^9.0.0": "9.0.9",
      "minimatch@^10.0.0": "10.2.3"
    }
  },
  "packageManager": "pnpm@10.21.0"
}
