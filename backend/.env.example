# ============================================
# Shipzy Backend Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Database Configuration
POSTGRES_DB=shipzy_dev
POSTGRES_USER=shipzy_user
POSTGRES_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_NAME=shipzy_dev
DB_USER=shipzy_user
DB_PASSWORD=your_postgres_password
DB_PORT=5432
DB_POOL_MAX=20

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000

# Logging
LOG_LEVEL=info
LOG_QUERIES=true

# ngrok Configuration (for development with public HTTPS)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-domain.ngrok-free.app

# Firebase Configuration (Legacy - handled via service account key file)
# Only needed if not using the Firebase service account key file
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE_KEY-----"
