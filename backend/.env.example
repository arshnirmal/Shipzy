# ============================================
# Shipzy Backend Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Database Configuration
# Neon/Postgres connection string (recommended for Neon)
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipzy_dev
DB_USER=shipzy_user
# Required when DATABASE_URL is not provided
DB_PASSWORD=your_postgres_password
DB_POOL_MAX=20

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000

# Logging
LOG_LEVEL=info
LOG_QUERIES=true

# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
MAPBOX_BASE_URL=https://api.mapbox.com

# ngrok Configuration (for development with public HTTPS)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-domain.ngrok-free.app

# Firebase Configuration (Legacy - handled via service account key file)
# Only needed if not using the Firebase service account key file
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ---------------------------------------------------------------------------
# Seeded platform admin (pnpm run db:seed:master → master-data.sql)
# Email: admin@shipzy.local
# Default password (development only): ShipzyAdminDev!2026
# Rotate credentials before any production or shared deployment.
# ---------------------------------------------------------------------------
