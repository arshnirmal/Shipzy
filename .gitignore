# ============================================================================
# SHIPZY MONOREPO - ROOT .GITIGNORE
# ============================================================================
# This file covers Flutter apps (user/driver), Node.js backend, and shared packages

# ============================================================================
# GENERAL - IDE & EDITOR FILES
# ============================================================================
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
.env
.env.*
.env.local
.env.*.local
!.env.example

# Firebase Admin SDK service account keys (CRITICAL - NEVER COMMIT)
*firebase-adminsdk*.json
shipzy-*-firebase-adminsdk-*.json

# Firebase configuration files (if they contain sensitive data)
# Uncomment these if your firebase config files contain secrets
# google-services.json
# GoogleService-Info.plist

