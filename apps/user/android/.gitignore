# ============================================================================
# Shipzy User App - Android .gitignore
# ============================================================================
# Android application .gitignore for the Shipzy user mobile app
# Includes comprehensive patterns for Android development and Flutter
# ============================================================================

# ============================================================================
# Gradle & Build System
# ============================================================================

# Gradle
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Gradle Wrapper
gradle/wrapper/gradle-wrapper.jar

# Android Studio
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/misc.xml
*.iml
*.ipr
*.iws

# ============================================================================
# Android Build Artifacts
# ============================================================================

# APK and AAB files
*.apk
*.aab
*.apks

# Android Studio captures folder
captures/

# Local configuration file (sdk path, etc)
local.properties

# ============================================================================
# Signing & Keystores (NEVER COMMIT)
# ============================================================================

# Signing configuration
key.properties
**/key.properties

# Keystores
**/*.keystore
**/*.jks
**/*.p12
**/*.pfx

# Upload keys (for Google Play)
**/*.json
!**/google-services.json

# ============================================================================
# Flutter Android Integration
# ============================================================================

# Flutter wrapper
gradlew
gradlew.bat

# Flutter Generated files
GeneratedPluginRegistrant.java

# Flutter plugins
.cxx/

# ============================================================================
# IDEs & Editors
# ============================================================================

# VS Code
.vscode/

# Cursor IDE
.cursor/

# ============================================================================
# Operating Systems
# ============================================================================

# macOS
.DS_Store
.DS_Store?
._*

# Linux
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================================
# Logs & Temporary Files
# ============================================================================

# Logs
*.log
logs/

# Temporary files
.tmp/
temp/
.cache/

# ============================================================================
# Development & Testing
# ============================================================================

# Test coverage
coverage/
*.cover

# Android Test Orchestrator
orchestrator/*/results/

# ============================================================================
# Environment & Secrets
# ============================================================================

# Environment files
.env
.env.local
.env.production

# ============================================================================
# Legacy & Miscellaneous
# ============================================================================

# Old build artifacts
bin/
gen/
out/

# Eclipse
.project
.classpath
.settings/

# IntelliJ
*.iws
.idea/workspace.xml
.idea/tasks.xml

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/
